{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "The AWS CloudFormation template for this Serverless application",
  "Resources": {
    "SurveyTable": {
      "Type": "AWS::DynamoDB::Table",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "TableName": "prod-core-sbk-survey",
        "DeletionProtectionEnabled": {
          "Fn::If": [
            "IsProduction",
            true,
            false
          ]
        },
        "BillingMode": "PAY_PER_REQUEST",
        "AttributeDefinitions": [
          {
            "AttributeName": "PK",
            "AttributeType": "S"
          },
          {
            "AttributeName": "SK",
            "AttributeType": "S"
          },
          {
            "AttributeName": "gsi1PK",
            "AttributeType": "S"
          },
          {
            "AttributeName": "gsi1SK",
            "AttributeType": "S"
          },
          {
            "AttributeName": "gsi2PK",
            "AttributeType": "S"
          },
          {
            "AttributeName": "gsi2SK",
            "AttributeType": "S"
          },
          {
            "AttributeName": "entity_type",
            "AttributeType": "S"
          }
        ],
        "KeySchema": [
          {
            "AttributeName": "PK",
            "KeyType": "HASH"
          },
          {
            "AttributeName": "SK",
            "KeyType": "RANGE"
          }
        ],
        "GlobalSecondaryIndexes": [
          {
            "IndexName": "IDXinv",
            "KeySchema": [
              {
                "AttributeName": "SK",
                "KeyType": "HASH"
              },
              {
                "AttributeName": "PK",
                "KeyType": "RANGE"
              }
            ],
            "Projection": {
              "ProjectionType": "ALL"
            }
          },
          {
            "IndexName": "gsi1",
            "KeySchema": [
              {
                "AttributeName": "gsi1PK",
                "KeyType": "HASH"
              },
              {
                "AttributeName": "gsi1SK",
                "KeyType": "RANGE"
              }
            ],
            "Projection": {
              "ProjectionType": "ALL"
            }
          },
          {
            "IndexName": "gsi1inv",
            "KeySchema": [
              {
                "AttributeName": "gsi1SK",
                "KeyType": "HASH"
              },
              {
                "AttributeName": "gsi1PK",
                "KeyType": "RANGE"
              }
            ],
            "Projection": {
              "ProjectionType": "ALL"
            }
          },
          {
            "IndexName": "gsi2",
            "KeySchema": [
              {
                "AttributeName": "gsi2PK",
                "KeyType": "HASH"
              },
              {
                "AttributeName": "gsi2SK",
                "KeyType": "RANGE"
              }
            ],
            "Projection": {
              "ProjectionType": "ALL"
            }
          },
          {
            "IndexName": "gsi2inv",
            "KeySchema": [
              {
                "AttributeName": "gsi2SK",
                "KeyType": "HASH"
              },
              {
                "AttributeName": "gsi2PK",
                "KeyType": "RANGE"
              }
            ],
            "Projection": {
              "ProjectionType": "ALL"
            }
          },
          {
            "IndexName": "typeIDX",
            "KeySchema": [
              {
                "AttributeName": "entity_type",
                "KeyType": "HASH"
              },
              {
                "AttributeName": "PK",
                "KeyType": "RANGE"
              }
            ],
            "Projection": {
              "ProjectionType": "ALL"
            }
          }
        ],
        "PointInTimeRecoverySpecification": {
          "PointInTimeRecoveryEnabled": {
            "Fn::If": [
              "IsProduction",
              true,
              false
            ]
          }
        },
        "SSESpecification": {
          "SSEEnabled": true
        },
        "Tags": [
          {
            "Key": "STAGE",
            "Value": "prod"
          },
          {
            "Key": "DanceEngineVersion",
            "Value": "v2"
          }
        ]
      }
    },
    "SurveyApplicationRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "RoleName": "prod-sbk-survey-application",
        "Description": "Allows the Vercel SBK survey application to store contacts and survey responses.",
        "MaxSessionDuration": 3600,
        "AssumeRolePolicyDocument": {
          "Fn::Sub": "{\n  \"Version\": \"2012-10-17\",\n  \"Statement\": [\n    {\n      \"Effect\": \"Allow\",\n      \"Principal\": {\n        \"Federated\": \"arn:aws:iam::717279731911:oidc-provider/oidc.vercel.com/dance-engine\"\n      },\n      \"Action\": \"sts:AssumeRoleWithWebIdentity\",\n      \"Condition\": {\n        \"StringEquals\": {\n          \"oidc.vercel.com/dance-engine:aud\": \"https://vercel.com/dance-engine\",\n          \"oidc.vercel.com/dance-engine:sub\": [\n            \"owner:dance-engine:project:the-engine-survey:environment:production\",\n            \"owner:dance-engine:project:the-engine-survey:environment:production\"\n          ]\n        }\n      }\n    }\n  ]\n}\n"
        },
        "Policies": [
          {
            "PolicyName": "SurveyTableAccess",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Sid": "WriteContactDetails",
                  "Effect": "Allow",
                  "Action": [
                    "dynamodb:PutItem",
                    "dynamodb:UpdateItem"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:dynamodb:${AWS::Region}:${AWS::AccountId}:table/prod-core-danceengine"
                  }
                },
                {
                  "Sid": "WriteSurveyResponses",
                  "Effect": "Allow",
                  "Action": [
                    "dynamodb:PutItem"
                  ],
                  "Resource": {
                    "Fn::GetAtt": [
                      "SurveyTable",
                      "Arn"
                    ]
                  }
                }
              ]
            }
          }
        ]
      }
    },
    "SurveyResultsRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "RoleName": "prod-sbk-survey-results",
        "Description": "Allows the Vercel SBK survey results endpoint to query aggregated response data.",
        "MaxSessionDuration": 3600,
        "AssumeRolePolicyDocument": {
          "Fn::Sub": "{\n  \"Version\": \"2012-10-17\",\n  \"Statement\": [\n    {\n      \"Effect\": \"Allow\",\n      \"Principal\": {\n        \"Federated\": \"arn:aws:iam::717279731911:oidc-provider/oidc.vercel.com/dance-engine\"\n      },\n      \"Action\": \"sts:AssumeRoleWithWebIdentity\",\n      \"Condition\": {\n        \"StringEquals\": {\n          \"oidc.vercel.com/dance-engine:aud\": \"https://vercel.com/dance-engine\",\n          \"oidc.vercel.com/dance-engine:sub\": [\n            \"owner:dance-engine:project:the-engine-survey:environment:production\",\n            \"owner:dance-engine:project:the-engine-survey:environment:development\"\n          ]\n        }\n      }\n    }\n  ]\n}\n"
        },
        "Policies": [
          {
            "PolicyName": "QuerySurveyResults",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Sid": "QuerySurveyResponseIndex",
                  "Effect": "Allow",
                  "Action": [
                    "dynamodb:Query"
                  ],
                  "Resource": {
                    "Fn::Sub": [
                      "${TableArn}/index/typeIDX",
                      {
                        "TableArn": {
                          "Fn::GetAtt": [
                            "SurveyTable",
                            "Arn"
                          ]
                        }
                      }
                    ]
                  }
                }
              ]
            }
          }
        ]
      }
    }
  },
  "Outputs": {
    "ServerlessDeploymentBucketName": {
      "Value": "serverless-framework-deployments-eu-west-1-0e22de09-8583",
      "Export": {
        "Name": "sls-core-sbk-survey-prod-ServerlessDeploymentBucketName"
      }
    },
    "SurveyTableName": {
      "Description": "DynamoDB table used for survey responses.",
      "Value": {
        "Ref": "SurveyTable"
      }
    },
    "SurveyApplicationRoleArn": {
      "Description": "IAM role for the Vercel survey application.",
      "Value": {
        "Fn::GetAtt": [
          "SurveyApplicationRole",
          "Arn"
        ]
      }
    },
    "SurveyResultsRoleArn": {
      "Description": "Query-only IAM role for the Vercel survey results endpoint.",
      "Value": {
        "Fn::GetAtt": [
          "SurveyResultsRole",
          "Arn"
        ]
      }
    }
  },
  "Conditions": {
    "IsProduction": {
      "Fn::Equals": [
        "prod",
        "prod"
      ]
    }
  }
}