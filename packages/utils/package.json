      "actions/*": [
        "dist/actions/*.d.ts"
      ]
    }
  },
  "devDependencies": {
    "@dance-engine/typescript-config": "workspace:*",
    "typescript": "latest"
  },
  "peerDependencies": {
    "@clerk/nextjs": "^6.14.0"
  },
  "dependencies": {
    "@clerk/types": "^4.49.1",
    "@dance-engine/schemas": "workspace:*",
    "@types/react": "^19.0.12",
    "@types/react-dom": "^19.0.4",
    "@vercel/edge-config": "^1.4.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "little-state-machine": "^5.0.1",
    "react": "^19.0.0",
    "react-autosave": "^0.5.0",
    "react-dom": "^19.0.0",
    "swr": "^2.3.3",
    "zod": "^3.24.2"
  }
}
