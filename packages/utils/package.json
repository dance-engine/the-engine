{
  "name": "@dance-engine/utils",
  "type": "module",
  "scripts": {
    "dev": "tsc --watch",
    "build": "tsc"
  },
  "exports": {
    "./clerkSWR": {
      "default": "./dist/clerkSWR.js"
    },
    "./getInnerSchema": {
      "default": "./dist/getInnerSchema.js"
    },
    "./textHelpers": {
      "default": "./dist/textHelpers.js"
    },
    "./arrayHelpers": {
      "default": "./dist/arrayHelpers.js"
    },
    "./OrgContext": {
      "default": "./src/hooks/OrgContext.tsx"
    },
    "./StateContext": {
      "default": "./src/hooks/GlobalState.ts"
    },
    "./LocalAutosave": {
      "default": "./src/hooks/LocalAutosave.ts"
    },
    "./pricingUtilties": {
      "default": "./src/pricingUtilties.ts"
    },
    "./actions/*": "./dist/actions/*.js",
    "./solo-edge-config": {
      "default": "./dist/solo-edge-config.js"
    },
    "./solo-themes": {
      "default": "./dist/solo-themes.js"
    },
    "./solo-edge-config-write": {
      "default": "./dist/solo-edge-config-write.js"
    }
  },
  "typesVersions": {
